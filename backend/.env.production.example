# Backend Production Environment Variables
# Copy to .env and fill in your values

# MongoDB Atlas connection string
# Format: mongodb+srv://username:password@cluster.mongodb.net/database?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://tasksphere_admin:your_password_here@tasksphere.xxxxx.mongodb.net/tasksphere?retryWrites=true&w=majority

# JWT Secret (min 32 characters for security)
JWT_SECRET=your-super-secure-jwt-secret-key-min-32-chars-long-production-only

# Server port (Railway will use PORT environment variable)
PORT=5000

# Environment
NODE_ENV=production

# Frontend URL for CORS
FRONTEND_URL=https://tasksphere-xxx.vercel.app
